<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+: the session token stays on this device, out of cloud backup and device-to-device
   transfer alike (see KeystoreSecureStorage and backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lurker_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lurker_session.xml" />
    </device-transfer>
</data-extraction-rules>
