<?xml version="1.0" encoding="utf-8"?>
<!--
   Cleartext is permitted everywhere because it can't be permitted only where it is wanted: a
   self-hoster's LAN box is a private IP, a .local name or a single-word host, and this file
   matches domain names, not address ranges — "private addresses only" cannot be said here.
   The policy lives in the kit instead, in two layers that ask one definition
   (LocalNetworking.permitsCleartext): ServerAddress refuses http:// to anything but the local
   network at sign-in and restore, with sign-in copy rather than a failed connect
   (lurker-android#17); and CleartextPolicy, an interceptor on every OkHttp client the kit
   builds, is the authoritative refusal for whatever reaches the wire — REST, the socket upgrade,
   uploads and server-minted media addresses alike.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
